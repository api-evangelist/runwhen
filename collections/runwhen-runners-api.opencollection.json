{
  "opencollection": "1.0.0",
  "info": {
    "name": "papi alert-query-proxy runners API",
    "version": "2.0.0"
  },
  "items": [
    {
      "info": {
        "name": "runners",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all runners",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v3/runners",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of results"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of results to skip"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List all runners, ordered by id descending."
        },
        {
          "info": {
            "name": "Get a runner by UUID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v3/runners/:runner_uuid",
            "params": [
              {
                "name": "runner_uuid",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get a single runner by its UUID."
        }
      ]
    }
  ],
  "bundled": true
}