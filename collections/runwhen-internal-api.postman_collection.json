        {
          "id": "e6672845-7d4a-4d9b-9a50-a777fe93a1c4",
          "name": "Generate upload config (internal)",
          "request": {
            "name": "Generate upload config (internal)",
            "description": {
              "content": "Generate upload credentials for runner-control.\n\nReturns a short-lived SA token and the public PAPI URL so runner-control\ncan assemble a complete ``uploadInfo`` for workspace-builder.\n\n**Network isolation:** This endpoint MUST be blocked from external access\nvia an ingress deny rule on ``/*/internal/*`` (same pattern as ``/metrics``).\nRunner-control reaches PAPI through the cluster-internal Service URL, which\nbypasses ingress. The ``RW-Runner-Token`` header is required as a secondary\nguard but is not cryptographically validated by PAPI — runner-control already\nvalidated the token before making this call.\n\n**Why require a non-empty header at all?** Largely a lightweight handshake so\nthe caller is clearly runner-control (or anything that holds the runner token),\nnot arbitrary cluster traffic. It does not strengthen auth on the PAPI side.\n\n**Future consideration:** If this endpoint remains strictly internal-only and\nPAPI never gains cryptographic validation of the runner token, the header could\nbe removed entirely — it would not change the trust model on PAPI (isolation\nis ClusterIP + ingress deny). Doing so would require a coordinated change with\nrunner-control and regression testing; we keep the header until then to avoid\nchurn on a path that already works.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "workspaces",
                ":workspace_name",
                "internal",
                "upload-config"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "workspace_name",
                  "description": "(Required) "
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) ",
                "key": "RW-Runner-Token",
                "value": "<string>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
          "response": [
