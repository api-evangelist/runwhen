        {
          "info": {
            "name": "Ws List Command Executions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v3/workspaces/:workspace_name/chat-config/commands/:command_id/executions",
            "params": [
              {
                "name": "workspace_name",
                "value": "",
