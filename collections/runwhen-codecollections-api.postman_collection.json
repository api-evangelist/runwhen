        {
          "id": "81c2bdb7-68bd-4026-b454-e1ed2ab0101d",
          "name": "Get codecollection detail with codebundles",
          "request": {
            "name": "Get codecollection detail with codebundles",
            "description": {
              "content": "Get detailed codecollection info including parsed codebundles.\n\nClones the codecollection git repo (shallow), walks the codebundles/\ndirectory, parses .robot files, and returns structured codebundle\nmetadata. Mirrors Django ``CodeCollectionViewSet.get_detail()``.\n\nThe full unfiltered response is cached in Redis under\n``cc:detail:{name}`` for ``_CC_DETAIL_CACHE_TTL`` seconds. ``rfns`` is\napplied AFTER the cache lookup so SLI and runbook callers share the\nsame cache entry. Cache is best-effort: any Redis error falls through\nto a fresh git clone.\n\nThe ``reconcile_single_code_collection`` taskiq job pre-warms this\ncache after each reconcile tick, so first-user latency is only paid\nfor collections added between cron ticks.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v3",
                "codecollections",
                ":name",
                "tmp"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "rfns",
                  "value": "<string>",
                  "description": "Restrict returned codeBundles to this kind."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "name",
                  "description": "(Required) "
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
