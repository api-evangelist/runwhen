          "id": "cd7bfbee-d317-40cb-bac6-cd7530250757",
          "name": "Auth0 Callback",
          "request": {
            "name": "Auth0 Callback",
            "description": {
              "content": "Handle Auth0 OAuth2 callback.\n\nExchanges authorization code for tokens, fetches userinfo, creates or\nlinks the user, issues a JWT cookie, and redirects to the next URL.\n\nArgs:\n    request: The incoming request.\n    code: Authorization code from Auth0.\n    state: State parameter for CSRF validation.\n    error: Error code from Auth0 (if any).\n    error_description: Error description from Auth0 (if any).\n\nReturns:\n    Redirect to next URL with JWT cookie set.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "accounts",
                "auth0",
                "login",
                "callback",
                ""
