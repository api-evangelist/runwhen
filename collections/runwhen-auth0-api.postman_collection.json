          "name": "Login Redirect",
          "request": {
            "name": "Login Redirect",
            "description": {
              "content": "Redirect to a base64-encoded URL after login, with host whitelist validation.\n\nThis matches Django's core/login.py:rd() view exactly. The URL is base64-encoded\nto avoid issues with OAuth providers stripping query parameters.\n\nArgs:\n    nxt_raw: Base64-encoded absolute URL to redirect to.\n\nReturns:\n    Redirect to the decoded URL if host is allowed, or to an error page.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rd",
                ":nxt_raw"
              ],
              "host": [
                "{{baseUrl}}"
