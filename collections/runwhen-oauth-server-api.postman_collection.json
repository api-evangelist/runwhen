        {
          "id": "00b09e09-2a89-45fc-8a83-cbd98373827f",
          "name": "Oauth Authorize Oidc Login",
          "request": {
            "name": "Oauth Authorize Oidc Login",
            "description": {
              "content": "Begin a standalone upstream-OIDC login (dual-mode).\n\nResolves the IdP's authorization endpoint via discovery, stores PKCE +\nstate, and redirects the browser to the upstream IdP, which returns to\n``/oauth/authorize/callback/{idp_name}``. Two callers:\n\n* **OAuth 2.1 client** (MCP/Slack via ``/oauth/authorize``): passes\n  ``oauth_session``; the callback issues an auth code back to the client.\n* **First-party UI** (``login.tsx``): passes ``next``; the callback sets a\n  JWT cookie and redirects to ``next`` (mirrors ``/accounts/auth0/login/``).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "oauth",
                "authorize",
                "login",
                ":idp_name"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "oauth_session",
                  "value": ""
                },
                {
                  "disabled": false,
                  "key": "next",
                  "value": ""
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "idp_name",
                  "description": "(Required) "
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
