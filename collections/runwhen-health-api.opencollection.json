              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Root endpoint for nginx-ingress backend health checks."
        },
        {
          "info": {
            "name": "Health",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/healthz"
          },
          "docs": "Check overall service health.\n\nUsed by K8s readiness and startup probes.\nReturns 503 during graceful shutdown to drain traffic.\n\nReturns:\n    Health status with version information."
        },
        {
          "info": {
            "name": "Health",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          },
          "docs": "Check overall service health.\n\nUsed by K8s readiness and startup probes.\nReturns 503 during graceful shutdown to drain traffic.\n\nReturns:\n    Health status with version information."
        },
        {
          "info": {
            "name": "Liveness",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/livez"
