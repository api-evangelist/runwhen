{
  "opencollection": "1.0.0",
  "info": {
    "name": "papi alert-query-proxy persona-v4 API",
    "version": "2.0.0"
  },
  "items": [
    {
      "info": {
        "name": "persona-v4",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Personas",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v4/workspaces/:workspace_name/personas",
            "params": [
              {
                "name": "workspace_name",
                "value": "",
                "type": "path"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of results"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of results to skip"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List Personas"
        },
        {
          "info": {
            "name": "Get Persona",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v4/workspaces/:workspace_name/personas/:persona_short_name",
            "params": [
              {
                "name": "workspace_name",
                "value": "",
                "type": "path"
              },
              {
                "name": "persona_short_name",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get Persona"
        },
        {
          "info": {
            "name": "Soft-delete a Persona (V4, short-name URL)",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v4/workspaces/:workspace_name/personas/:persona_short_name",
            "params": [
              {
                "name": "workspace_name",
                "value": "",
                "type": "path"
              },
              {
                "name": "persona_short_name",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Soft-delete a Persona by its short name (mirrors the v4 GET URL)."
        },
        {
          "info": {
            "name": "Upsert a Persona (V4 typed payload)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v4/workspaces/:workspace_name/personas/sync-typed",
            "params": [
              {
                "name": "workspace_name",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Upsert a Persona (V4 typed payload)"
        }
      ]
    }
  ],
  "bundled": true
}