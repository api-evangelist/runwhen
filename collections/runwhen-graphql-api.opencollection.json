{
  "opencollection": "1.0.0",
  "info": {
    "name": "papi alert-query-proxy Graphql API",
    "version": "2.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Graphql",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Handle Http Get",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/graphql",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Handle Http Get"
        },
        {
          "info": {
            "name": "Handle Http Post",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/graphql",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Handle Http Post"
        }
      ]
    }
  ],
  "bundled": true
}