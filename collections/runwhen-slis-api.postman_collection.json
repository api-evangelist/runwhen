          "name": "Get the SLI for an SLX",
          "request": {
            "name": "Get the SLI for an SLX",
            "description": {
              "content": "Get the SLI for an SLX.\n\nSLX and SLI have a 1:1 relationship. This endpoint returns the single\nSLI associated with the specified SLX, or 404 if no SLI exists.\n\nArgs:\n    workspace_name: The workspace name.\n    slx_short_name: The SLX short name.\n    _detail: Django parity query param (ignored).\n    session: Database session.\n    current_user: The authenticated user.\n\nReturns:\n    The SLI details.\n\nRaises:\n    HTTPException: 404 if workspace, SLX, or SLI not found.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "workspaces",
                ":workspace_name",
                "slxs",
                ":slx_short_name",
                "sli"
