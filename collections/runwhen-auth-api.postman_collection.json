          "name": "Obtain Token",
          "request": {
            "name": "Obtain Token",
            "description": {
              "content": "Obtain JWT access and refresh tokens.\n\nAccepts either username or email with password for authentication.\nCompatible with Django REST Framework SimpleJWT token endpoint.\nSupports both application/json and application/x-www-form-urlencoded.\n\nArgs:\n    request: The incoming HTTP request.\n\nReturns:\n    TokenResponse with access and refresh JWT tokens.\n\nRaises:\n    HTTPException: 401 if credentials are invalid.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v3",
                "token",
                ""
