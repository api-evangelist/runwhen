        {
          "id": "32e42ccb-3458-40f4-ad57-fa716dcbf6d5",
          "name": "Exchange an external token for a PAPI JWT",
          "request": {
            "name": "Exchange an external token for a PAPI JWT",
            "description": {
              "content": "Exchange an Auth0 access token for a PAPI JWT.\n\nThis endpoint implements a simplified RFC 8693 token exchange. It\nvalidates the Auth0 token against Auth0's /userinfo endpoint, looks up\nthe corresponding PAPI user by email, and issues a PAPI JWT.\n\nIntended for use by the MCP server after completing an OAuth 2.1 flow\nwith Auth0 — the MCP server receives an Auth0 access token from the\ninteractive login and exchanges it here for a PAPI JWT that can be\nused for API calls.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v3",
                "token",
                "exchange",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject_token\": \"<string>\",\n  \"grant_type\": \"urn:ietf:params:oauth:grant-type:token-exchange\",\n  \"subject_token_type\": \"auth0\",\n  \"scope\": \"openid profile email\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
